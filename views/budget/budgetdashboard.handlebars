    <style>
        body {
            font-family: 'Nunito', sans-serif;
        }

        .container-viewcategory, .container-view-update {
            margin: 20px auto;
            padding: 20px;
            border-radius: 8px;
            background-color: #ffffff;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            max-width: 1200px;
            overflow: hidden;
        }

        .container h3 {
            font-size: 1.5rem;
            color: #333333;
            margin-bottom: 15px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            table-layout: fixed; 
            font-size: 14px;
        }

        table th, table td {
            padding: 15px;
            text-align: left;
            border: 1px solid #dddddd; 
            white-space: normal; 
            overflow: hidden;
            text-overflow: ellipsis; 
        }

        table th {
            background-color: #f0f0f0;
            color: #555555;
            font-weight: bold;
            text-transform: uppercase;
            font-size: 13px;
        }

        table tbody tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        table tbody tr:hover {
            background-color: #e0f7fa;
            transition: background-color 0.3s ease;
        }

        @media (max-width: 768px) {
            .container {
                padding: 15px;
            }

            table th, table td {
                padding: 12px; 
            }
        }

        .action-btn {
            padding: 8px 15px;
            font-size: 12px;
            cursor: pointer;
            border: none;
            border-radius: 5px;
            transition: background-color 0.3s ease, transform 0.3s ease;
            color: white;
            width: 80px;
            text-align: center;
            margin-right: 5px;
        }

        .update-btn {
            background-color: #ebca5f;
        }

        .update-btn:hover {
            background-color: #bea243;
            transform: scale(1.05);
        }

        .delete-btn {
            background-color: #ff4d4d;
        }

        .delete-btn:hover {
            background-color: #cc0000;
            transform: scale(1.05);
        }

        .button-group {
            display: flex;
            justify-content: flex-start;
        }

        .view-all-button {
            display: inline-block;
            padding: 10px 20px;
            font-size: 1em;
            color: #fff;
            background-color: #5f5f5f;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            text-align: center;
            margin-top: 20px;
            transition: background-color 0.3s ease;
        }

        .view-all-button:hover {
            background-color: #2b2929;
        }

        .progress-container {
            position: relative;
            width: 70%;
            height: 20px;
            background-color: #e0e0e0;
            border-radius: 10px;
            margin: 10px 0;
        }

        .progress-bar {
            position: absolute;
            height: 100%;
            border-radius: 10px;
        }

        .progress-percentage {
            position: absolute;
            width: 100%;
            text-align: center;
            top: 0;
            line-height: 20px;
            font-size: 14px;
            font-weight: bold;
            color: #333;
        }

        .sidebar {
            width: 250px;
            background-color: #ffffff;
            padding: 20px;
            color: #333;
            height: 100vh;
            position: fixed;
            box-shadow: 2px 0 5px rgba(0, 0, 0, 0.1);
        }

        .sidebar h2 {
            color: #ebca5f;
            text-align: left;
            margin-bottom: 20px;
            font-size: 20px;
        }

        .sidebar ul {
            list-style: none;
            padding: 0;
        }

        .sidebar ul li {
            margin-bottom: 20px;
        }

        .sidebar ul li a {
            color: #333;
            text-decoration: none;
            font-size: 18px;
            display: block;
            padding: 10px;
            border-radius: 5px;
            transition: background-color 0.3s ease;
        }

        .sidebar ul li a:hover {
            background-color: #ebca5f;
            color: #fff;
        }
    </style>
</head>
<body>

    <div class="sidebar">
        <h2>Budget Dashboard</h2>
        <ul>
            <li><a href="/expensesdashboard">Expenses Dashboard</a></li>
            <li><a href="/expensesform">Add Expenses</a></li>
        </ul>
    </div>

    <div class="container-xxl py-5">
        <div class="container">
            <div class="text-center wow fadeInUp" data-wow-delay="0.1s">
                <h1 class="mb-5">MANAGE YOUR OWN EXPENSES</h1>
                <h6 class="section-title bg-white text-center text-primary px-3">- DASHBOARD -</h6>
            </div>
        </div>
    </div>

    <div class="container-viewcategory">
        <h3>All Budgets</h3>
        <table id="transactionsTableCategory" border="1">
            <thead>
                <tr>
                    <th>Category</th>
                    <th>Budget Set</th>
                    <th>Month</th>
                    <th>Total Spent</th>
                    <th>Remaining Amount</th>
                    <th>How far are you from your budget?</th> 
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {{#each budget}}
                <tr>
                    <td>{{category}}</td>
                    <td>{{amount}}</td>
                    <td>{{month}}</td>
                    <td>{{totalSpent}}</td>
                    <td>{{remainingAmount}}</td>
                    <td>
                        <div class="progress-container">
                            <div class="progress-bar" style="width: {{progress}}%;" data-progress="{{progress}}"></div>
                            <div class="progress-percentage">{{progress}}%</div>
                        </div>
                    </td>
                    <td>
                        <div class="button-group">
                            <button type="button" class="action-btn update-btn"
                                onclick="showUpdateForm('{{id}}', '{{amount}}')">
                                Update
                            </button>
                        </div>
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
        <button type="button" class="view-all-button" onclick="window.location.href='/budgetform'">
            Set Your Budget
        </button>
    </div>

    <div class="container-view-update">
        <div id="update-form" style="display: none;">
            <h3>Update Budget</h3>
            <form action="/budget/updateBudget" method="POST">
                <input type="hidden" id="update-id" name="id">

                <label for="amount">Amount *</label>
                <input type="number" id="amount" name="amount" class="form-input" step="0.01" required>
                <br>
                <br>
                <div class="button-group">
                    <button type="submit" class="action-btn update-btn">
                        Update
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function showUpdateForm(id, amount) {
            document.getElementById('update-form').style.display = 'block';
            document.getElementById('update-id').value = id;
            document.getElementById('amount').value = amount;
        }


        function getProgressBarColor(progress) {
            if (progress <= 20) {
                return '#4dff88'; // Green
            } else if (progress <= 40) {
                return '#b0ff4d'; // Light Green
            } else if (progress <= 60) {
                return '#ffe94d';  // Yellow
            } else if (progress <= 80) {
                return '#ffaf4d'; // Orange
            } else {
                return '#ff4d4d';  // Red
            }
        }

        document.addEventListener("DOMContentLoaded", function() {
            var progressBars = document.querySelectorAll('.progress-bar');
            progressBars.forEach(function(bar) {
                var progress = bar.getAttribute('data-progress');
                var color = getProgressBarColor(progress);
                bar.style.backgroundColor = color;
                bar.style.width = Math.min(progress, 100) + '%'; // Limit the width to 100%
            });
        });

    </script>
