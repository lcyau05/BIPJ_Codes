<style>
    body {
        font-family: 'Nunito', sans-serif;
    }

    .rectangle-16,
    .rectangle-16 * {
        box-sizing: border-box;
    }

    .rectangle-16 {
        background: #FD8087;
        height: 94px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .headerinfo {
        text-align: center;
        margin: auto;
        padding: 30px;
    }

    .form-container {
        width: 80%;
        max-width: 600px; /* Adjust width as needed */
        margin: 20px auto; /* Center align and provide space */
        background-color: #f0f0f0; /* Light grey background */
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1); /* Box shadow for depth */
    }

    .form-field {
        margin-bottom: 15px;
    }

    .form-label {
        display: block;
        font-weight: bold;
        margin-bottom: 5px;
    }

    .form-input {
        width: 100%;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 5px;
        box-sizing: border-box;
        font-size: 14px;
    }

    .form-select {
        width: 100%;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 5px;
        box-sizing: border-box;
        font-size: 14px;
    }

    .form-button {
        background-color: #ABEFA5;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 5px;
        cursor: pointer;
        font-size: 16px;
        margin-right: 10px; /* Space between buttons */
    }

    .form-button:hover {
        background-color: #36d627; /* Darker shade on hover */
    }

    .form-actions {
        margin-top: 20px;
        text-align: center;
    }

    .back-button {
        background-color: #FF4003;
        color: white;
    }

    .back-button:hover {
        background-color: #bd3609;
    }

    .clear-button {
        background-color: #f5a300;
    }

    .clear-button:hover {
        background-color: #b47b0a;
    }

    .feedback-message {
        text-align: center;
        margin-top: 20px;
        display: none;
    }

    .success {
        color: green;
    }

    .error {
        color: red;
    }

    .piggy-bank {
        display: block;
        margin: 0 auto;
        width: 150px; /* Adjust the width as needed */
        height: auto;
    }
</style>

<div class="container-xxl py-5">
        <div class="container">
            <div class="text-center wow fadeInUp" data-wow-delay="0.1s">
                <h1 class="mb-5">MANAGE YOUR OWN EXPENSES</h1>
                <h6 class="section-title bg-white text-center text-primary px-3">- SET YOUR BUDGET NOW -</h6>
            </div>
        </div>
    </div>
<br>
    <img class="piggy-bank" src="/img/budget.jpg" alt="">

    <div class="form-container">
        <form id="budgetForm" action="/budget/budgetform" method="post">
            <div class="form-field">
                <label for="category" class="form-label">Category *</label>
                <select id="category" name="category" class="form-select" onchange="handleCategoryChange(event)">
                    <option value="">Select a category</option>
                    <option value="transfer">Transfer</option>
                    <option value="dining">Dining</option>
                    <option value="transportation">Transportation</option>
                    <option value="shopping">Shopping</option>
                    <option value="entertainment">Entertainment and Leisure</option>
                    <option value="others">Others</option>
                </select>
            </div>

            <div class="form-field">
                <label for="amount" class="form-label">Amount *</label>
                <input type="number" id="amount" name="amount" class="form-input" required>
            </div>

            <div id="predicted-amount" class="form-field"></div>
            
            <div class="form-actions">
                <button type="submit" class="form-button">Save</button>
                <button type="button" class="form-button clear-button" onclick="clearForm()">Clear</button>
                <button type="button" class="form-button back-button" onclick="goBack()">Back</button>
            </div>
        </form>
        <div class="feedback-message" id="feedbackMessage"></div>
    </div>

    <script>
        async function fetchPredictedBudget(category) {
            try {
                const response = await fetch('/predictivebudget', {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });

                if (!response.ok) {
                    throw new Error('Failed to fetch predicted budget');
                }

                const categoryAverages = await response.json();
                displayPredictedBudget(category, categoryAverages[category]);
            } catch (error) {
                console.error('Error fetching predicted budget:', error);
            }
        }

        function displayPredictedBudget(category, predictedAmount) {
            const predictionElement = document.getElementById('predicted-amount');
            if (predictedAmount) {
                predictionElement.textContent = `On average, you spend $${predictedAmount.toFixed(2)} on ${category}.`;
            } else {
                predictionElement.textContent = `Looks like you have not spent on ${category}.`;
            }
        }

        function handleCategoryChange(event) {
            const selectedCategory = event.target.value;
            if (selectedCategory) {
                fetchPredictedBudget(selectedCategory);
            } else {
                document.getElementById('predicted-amount').textContent = '';
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            const categorySelect = document.getElementById('category');
            categorySelect.addEventListener('change', handleCategoryChange);
        });

        function clearForm() {
            document.getElementById('budgetForm').reset(); // Reset form fields
            document.getElementById('predicted-amount').textContent = ''; // Clear predicted amount
        }

        function goBack() {
            window.history.back(); // Go back to previous page
        }

        document.getElementById('budgetForm').addEventListener('submit', function(event) {
            // Client-side validation feedback
            var category = document.getElementById('category').value;
            var amount = document.getElementById('amount').value;
            var feedbackMessage = document.getElementById('feedbackMessage');

            if (!category || amount <= 0) {
                event.preventDefault(); // Prevent form submission
                feedbackMessage.textContent = 'Amount must be a positive number.';
                feedbackMessage.classList.remove('success');
                feedbackMessage.classList.add('error');
                feedbackMessage.style.display = 'block';
            } else {
                feedbackMessage.textContent = 'Form submitted successfully!';
                feedbackMessage.classList.remove('error');
                feedbackMessage.classList.add('success');
                feedbackMessage.style.display = 'block';
            }
        });
</script>