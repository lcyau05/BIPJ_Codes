<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up Page</title>
    <style>
        /* Add your CSS styles here */
        .container-fluid {
            text-align: center;
        }

        .column {
            display: inline-block;
            vertical-align: top;
            margin: 10px;
            width: 45%;
        }

        label,
        .button {
            display: block;
            margin: 0 auto;
        }
    </style>
    <script>
        $(document).ready(function () {
            $('#password').on('input', function () {
                var password = $(this).val();
                // Length check
                if (password.length >= 8 && password.length <= 25) {
                    $('#lengthCheck').css('color', 'green');
                } else {
                    $('#lengthCheck').css('color', 'red');
                }
                // Special character check
                if (/[~*&^%$#@!]+/.test(password)) {
                    $('#specialCharCheck').css('color', 'green');
                } else {
                    $('#specialCharCheck').css('color', 'red');
                }
                // Case check
                if (/[A-Z]/.test(password) && /[a-z]/.test(password)) {
                    $('#caseCheck').css('color', 'green');
                } else {
                    $('#caseCheck').css('color', 'red');
                }
            });
        });
    </script>
</head>

<body>
    <div class="container-xxl py-5">
        <div class="container">
            <form action="/user/user_update" method="POST">
                <div class="about-item-content bg-white rounded p-5 h-100">
                    <h2>Update Profile</h2><br>
                    <div class="row">
                        <div class="column">
                            <h3>
                                <ul>Change Password:</ul>
                            </h3>
                            <label for="password">New Password:</label>
                            <input type="password" id="password" name="password" class="form-control"
                                value="{{user.password}}">
                            <label for="confirm_password">Confirm New Password:</label>
                            <input type="password" id="confirm_password" name="confirm_password" class="form-control"
                                value="{{user.confirm_password}}"><br><br>
                            <div class="column">
                                <div id="passwordGuidelines">
                                    <p id="lengthCheck">• 8-25 characters long</p>
                                    <p id="specialCharCheck">• Contain special characters (E.g. ~*&^%$#@!)</p>
                                    <p id="caseCheck">• Contain 1 uppercase & 1 lowercase character</p>
                                </div>
                            </div>

                            <div class="row">
                                <div class="column">
                                    <label for="email">Email:</label>
                                    <input type="email" id="email" name="email" class="form-control"
                                        value="{{user.email}}"><br><br>
                                </div>

                                <div class="column">
                                    <label for="phone_no">Phone No:</label>
                                    <input type="text" id="phone_no" name="phone_no" class="form-control"
                                        value="{{user.phone_no}}"><br><br>
                                </div>
                            </div>

                            <div class="row">
                                <div class="column">
                                    <label for="address">Address:</label>
                                    <input type="text" id="address" name="address" class="form-control"
                                        value="{{user.address}}"><br><br>
                                </div>
                                <div class="column">
                                    <label for="postal_code">Postal Code:</label>
                                    <input type="text" id="postal_code" name="postal_code" class="form-control"
                                        value="{{user.postal_code}}"><br><br>
                                </div>
                            </div>
                            <button type="submit">Update</button><br><br>\
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</body>