<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up Page</title>
    <link rel="stylesheet" href="/css/style.css">

    <style>
        :root {
            --main-color: #FD8087;

        }

        /* Header Container*/
        .breadcrumb {
            font-size: 1.1rem;
        }

        .breadcrumb .active {
            color: var(--main-color);
            font-weight: 500;
        }

        .header-container .signUp-header-text p {
            font-size: 2rem;
            font-weight: 800;
            color: var(--main-color);
        }

        .form-control {
            border-radius: 100px;
        }

        .form-area-container {
            margin-top: 5%;
        }

        .form-area-container label {
            font-size: 1.2rem;
            margin-bottom: 1%;
        }

        .form-area-container input {
            padding: 0.8rem;
        }

        .form-area-container input:focus {
            box-shadow: 0 0 0 .25rem rgba(253, 128, 135, 0.2);
            border: solid 1px var(--main-color);
        }

        .form-area-container .input_field {
            margin-bottom: 2%;
        }

        #passwordGuidelines {
            font-size: 0.875rem;
            color: #6c757d;
        }

        .form-area-container input[type="radio"] {
            padding: 0;
        }

        .section {
            display: none;
        }

        .section.active {
            display: block;
        }

        .button_container button {
            padding: 1rem 1.5rem;
            border-radius: 100px;
        }

        #prevBtn {
            background-color: #6c757d;
        }
    </style>
    <script>
        $(document).ready(function () {
            $('#password').on('input', function () {
                var password = $(this).val();
                // Length check
                if (password.length >= 8 && password.length <= 25) {
                    $('#lengthCheck').css('color', 'green');
                } else {
                    $('#lengthCheck').css('color', 'red');
                }
                // Special character check
                if (/[~*&^%$#@!]+/.test(password)) {
                    $('#specialCharCheck').css('color', 'green');
                } else {
                    $('#specialCharCheck').css('color', 'red');
                }
                // Case check
                if (/[A-Z]/.test(password) && /[a-z]/.test(password)) {
                    $('#caseCheck').css('color', 'green');
                } else {
                    $('#caseCheck').css('color', 'red');
                }
            });
        });
    </script>
</head>

<body>
    <div class="container-fluid my-5">
        <div class="container header-container my-5">
            <div class="signUp-header-text mb-4">
                <p>Sign Up</p>
            </div>
            <nav>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item active" id="breadcrumb1">User Information</li>
                    <li class="breadcrumb-item" id="breadcrumb2">Extra Information</li>
                </ol>
            </nav>
        </div>
        <div class="container form-area-container">
            <form action="/sign_up" method="POST">
                <div class="section section_1 active">
                    <div class="row mb-3">
                        <div class="col-lg-6 col-md-12">
                            <div class="input_field">
                                <label for="first_name">First Name:</label>
                                <input type="text" id="first_name" name="first_name" class="form-control"
                                    value="{{first_name}}" required>
                            </div>
                        </div>
                        <div class="col-lg-6 col-md-12">
                            <div class="input_field">
                                <label for="last_name">Last Name:</label>
                                <input type="text" id="last_name" name="last_name" class="form-control" required>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-lg-6 col-md-12">
                            <div class="input_field">
                                <label for="nric">NRIC (Last 4 Digit):</label>
                                <input type="text" id="nric" name="nric" class="form-control" value="{{nric}}" required>
                            </div>
                        </div>
                        <div class="col-lg-6 col-md-12">
                            <div class="input_field">
                                <label for="DOB">Date of Birth:</label>
                                <input type="date" id="DOB" name="DOB" class="form-control" value="{{DOB}}" required>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-lg-6 col-md-12">
                            <div class="input_field">
                                <label for="password">Password:</label>
                                <input type="password" id="password" name="password" class="form-control"
                                    value="{{password}}" required>

                                <div id="passwordGuidelines" class="mt-3">
                                    <ul>
                                        <li id="lengthCheck">8-25 characters long</li>
                                        <li id="specialCharCheck">Contain special characters (E.g. ~*&^%$#@!)</li>
                                        <li id="caseCheck">Contain 1 uppercase & 1 lowercase character</li>
                                        </ol>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6 col-md-12">
                            <div class="input_field">
                                <label for="confirm_password">Confirm Password:</label>
                                <input type="password" id="confirm_password" name="confirm_password"
                                    class="form-control" aria-describedby="passwordHelpBlock"
                                    value="{{confirm_password}}" required>

                                <div id="passwordHelpBlock" class="form-text mt-3">
                                    Confirm Password must match Password
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="section section2">
                    <div class="row mb-3">
                        <div class="col-lg-6 col-md-12">
                            <div class="input_field">
                                <label for="phone_no">Phone No:</label>
                                <input type="text" id="phone_no" name="phone_no" class="form-control"
                                    value="{{phone_no}}" required>
                            </div>
                        </div>
                        <div class="col-lg-6 col-md-12">
                            <div class="input_field">
                                <label for="postal_code">Postal Code:</label>
                                <input type="text" id="postal_code" name="postal_code" class="form-control"
                                    value="{{postal_code}}" required>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-lg-6 col-md-12">
                            <div class="input_field">
                                <label for="email">Email:</label>
                                <input type="email" id="email" name="email" class="form-control" value="{{email}}"
                                    required>
                            </div>
                        </div>
                        <div class="col-lg-6 col-md-12">
                            <div class="input_field">
                                <label for="address">Address:</label>
                                <input type="text" id="address" name="address" class="form-control" value="{{address}}"
                                    required>
                            </div>

                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-lg-6 col-md-12">
                            <div class="input_field radio">
                                <div>
                                    <label for="gender">Gender:</label>
                                </div>
                                <div>
                                    <div class="form-check">
                                        <input type="radio" id="male" name="gender" value="Male" value="{{Male}}"
                                            class="form-check-input">
                                        <label for="male" class="form-check-label">Male</label>
                                    </div>
                                    <div class="form-check">
                                        <input type="radio" id="female" name="gender" value="Female" value="{{Female}}"
                                            class="form-check-input">
                                        <label for="female" class="form-check-label">Female</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="button_container">
                    <button type="button" class="btn btn-primary" id="prevBtn" onclick="showPrevSection()"
                        style="display: none;">Previous</button>
                    <button type="button" class="btn btn-primary" id="nextBtn" onclick="showNextSection()">Next</button>
                    <button type="submit" class="btn btn-primary ms-3" id="submitBtn" style="display: none;">Sign
                        Up</button>
                </div>
            </form>
        </div>
    </div>
</body>

<script>
    let currentSection = 1;

    function showSection(section) {
        const sections = document.querySelectorAll('.section');
        sections.forEach((sec, index) => {
            sec.classList.remove('active');
            if (index + 1 === section) {
                sec.classList.add('active');
            }
        });
        updateBreadcrumb(section);
        document.getElementById('prevBtn').style.display = section === 1 ? 'none' : 'inline';
        document.getElementById('nextBtn').style.display = section === sections.length ? 'none' : 'inline';
        document.getElementById('submitBtn').style.display = section === sections.length ? 'inline' : 'none';
    }

    function showNextSection() {
        currentSection++;
        showSection(currentSection);
    }

    function showPrevSection() {
        currentSection--;
        showSection(currentSection);
    }

    function updateBreadcrumb(section) {
        const breadcrumbs = document.querySelectorAll('.breadcrumb-item');
        breadcrumbs.forEach((crumb, index) => {
            crumb.classList.remove('active');
            if (index + 1 === section) {
                crumb.classList.add('active');
            }
        });
    }

    // Initialize the first section as active
    showSection(currentSection);
</script>