<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;700&family=Inter:wght@400;700&display=swap"
        rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="css/style.css" rel="stylesheet">
    <title>GenWise Invoice</title>
    <link rel="icon" href="./img/genwise_bipj.png" type="image/x-icon">

    <!-- Include jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <style>
        .table-custom {
            width: 100%;
            border-radius: 10px;
            overflow: hidden;
            border: 2px solid #FD8087;
        }

        .table-custom th,
        .table-custom td {
            padding: 15px;
            text-align: center;
            font-size: 1rem;
        }

        .table-custom thead {
            background-color: #FD8087;
            color: #fff;
        }

        .table-custom tbody tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        .table-custom tbody tr:nth-child(odd) {
            background-color: #fff;
        }

        .table-custom th {
            font-weight: bold;
        }

        .table-custom td {
            font-size: 1.1rem;
        }

        .table-custom-container {
            text-align: center;
            margin: 0 auto;
        }

        .table-custom-container h4 {
            margin-bottom: 1rem;
        }
    </style>
</head>

<body>
    <div class="container mt-5 mb-5">
        <div class="row justify-content-center">
            <div class="col-md-10">
                <div class="card">
                    <div class="card-header bg-primary text-white text-center py-4">
                        <h2 class="mt-2">GenWise</h2>
                        <p>180 Ang Mo Kio Ave 8, Singapore 569830<br>+65 6451 5115</p>
                    </div>
                    <div class="card-body">
                        <h4 class="mb-4">Customer Details</h4>
                        <table class="table table-bordered table-striped">
                            <tbody>
                                <tr>
                                    <td style="width: 50%; background: #f8f9fa; padding: 10px;">
                                        <strong>Date:</strong> {{ insurancePlanCreation.createdAt }}<br>
                                        <strong>Payment type:</strong> Credit Card
                                        {{insurancePlanCreation.cardType}}<br>
                                        <strong>Delivery type:</strong> via Email
                                    </td>
                                    <td style="background: #f8f9fa; padding: 10px;">
                                        <strong>Invoice ID:</strong> #{{carDetails.insurancebought}}<br>
                                        <strong>E-mail:</strong> {{userDetails.email}}<br>
                                        <strong>Phone:</strong> {{userDetails.phone_no}}
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <h4 class="mt-5 mb-4 text-center">Insurance Plan Details</h4>
                        <div class="table-custom-container">
                            <table class="table table-custom table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <th>Features</th>
                                        <th>{{insurancePlanCreation.planName}}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#each insurancePlan}}
                                    <tr>
                                        <td>{{ this.featName }}</td>
                                        <td>
                                            {{#ifEquals this.planName ../insurancePlanCreation.planName}}
                                            {{ this.featCost }}
                                            {{else}}
                                            N/A
                                            {{/ifEquals}}
                                        </td>
                                    </tr>
                                    {{/each}}
                                    <tr>
                                        <td class="font-weight-bold">Total</td>
                                        <td class="font-weight-bold">${{insurancePlanCreation.totalCost}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="card-footer text-center py-4">
                        <h5>Terms and Conditions</h5>
                        <ul class="list-unstyled">
                            <li>1. All insurance plans are non-refundable once purchased.</li>
                            <li>2. Please ensure all provided information is accurate. Incorrect details may void your
                                insurance coverage.</li>
                            <li>3. The insurance coverage is subject to the terms and conditions outlined in the policy
                                document.</li>
                            <li>4. Claims must be reported within the timeframe specified in your insurance policy.</li>
                            <li>5. The insurer reserves the right to amend the terms and conditions of the policy at any
                                time.</li>
                            <li>6. The policyholder is responsible for understanding and complying with all policy terms
                                and conditions.</li>
                            <li>7. This insurance is only valid for the coverage period stated in the policy document.
                            </li>
                            <li>8. Any disputes arising from the insurance policy will be resolved in accordance with
                                the laws of Singapore.</li>
                            <li>9. By purchasing this insurance, you agree to abide by all the terms and conditions
                                stated herein.</li>
                        </ul>
                        <p class="mt-3">&copy; 2024 GenWise Insurance. All Rights Reserved.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- JavaScript Libraries -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="lib/wow/wow.min.js"></script>
    <script src="lib/easing/easing.min.js"></script>
    <script src="lib/waypoints/waypoints.min.js"></script>
    <script src="lib/counterup/counterup.min.js"></script>
    <script src="lib/lightbox/js/lightbox.min.js"></script>
    <script src="lib/owlcarousel/owl.carousel.min.js"></script>

    <!-- Template JavaScript -->
    <script src="js/main.js"></script>
</body>

</html>