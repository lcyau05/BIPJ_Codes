<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Inter:slnt,wght@-10..0,100..900&display=swap"
        rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link rel="stylesheet" href="lib/animate/animate.min.css" />
    <link href="lib/lightbox/css/lightbox.min.css" rel="stylesheet">
    <link href="lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">

    <!-- Include jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- Customized Bootstrap Stylesheet -->
    <link href="css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="css/style.css" rel="stylesheet">
    <title>GenWise</title>
    <link rel="icon" href="./img/genwise_bipj.png" type="image/x-icon">

    <script src="https://js.stripe.com/v3/"></script>
</head>

<body>
    <!-- Spinner Start -->
    <div id="spinner"
        class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
        <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
            <span class="sr-only">Loading...</span>
        </div>
    </div>
    <!-- Spinner End -->

    {{> navbars}}
    <div class="container-xxl py-5">
        <div class="container">
            <div class="text-center wow fadeInUp" data-wow-delay="0.1s">
                <h1 class="mb-5">CUSTOMISABLE INSURANCE PLAN</h1>
                <h6 class="section-title bg-white text-center text-primary px-3">- DRAW YOUR VERY OWN ART WORK! BUILD
                    THE
                    PERFECT PLAN FOR YOURSELF -</h6>
            </div>
        </div>
    </div><br><br>
    <div class="container">
        <div class="row">
            <div class="col-12 col-md-2" style="text-align: center;">
                <h4 style="text-align: center;">MEDICAL & LIFE INSURANCE</h4>
                <button class="insurance-button" data-type="Life">LIFE</button>
                <button class="insurance-button" data-type="Medical">MEDICAL</button>
            </div>
            <div class="col-12 col-md-8" style="text-align: center;">
                <div class="design"></div>
            </div>
            <div class="col-12 col-md-2" style="text-align: center;">
                <h4 style="text-align: center;">LIFESTYLE INSURANCE</h4>
                <button class="insurance-button" data-type="Car">CAR</button>
                <button class="insurance-button" data-type="Travel">TRAVEL</button>
                <button class="insurance-button" data-type="Home">HOME</button>
            </div>
        </div>
    </div>
    {{{body}}}
    <br><br><br>
    {{> footer}}
    <!-- Back to Top -->
    <a href="#" class="btn btn-primary btn-lg-square rounded-circle back-to-top"><i class="fa fa-arrow-up"></i></a>


    <!-- JavaScript Libraries -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="lib/wow/wow.min.js"></script>
    <script src="lib/easing/easing.min.js"></script>
    <script src="lib/waypoints/waypoints.min.js"></script>
    <script src="lib/counterup/counterup.min.js"></script>
    <script src="lib/lightbox/js/lightbox.min.js"></script>
    <script src="lib/owlcarousel/owl.carousel.min.js"></script>


    <!-- Template Javascript -->
    <script src="js/main.js"></script>

    <style>
        button {
            width: 177px;
            height: 59px;
            font-size: 22px;
            font-weight: 500;
            background: #FD8087;
            color: #fff;
            margin: 30px auto 20px auto;
            padding: 4% 8%;
            border: 2px solid #828282;
            border-radius: 20px;
            transition-duration: 0.5s;
        }

        button:hover {
            background: #FD8087;
        }

        button.active {
            background-color: #40c6d4 !important;
            color: #000 !important;
        }


        .design {
            width: 551px;
            height: 485px;
            flex-shrink: 0;
            border-radius: 90px;
            background: #C3CCEC;
            margin: 0 auto;
            /* This will center the element horizontally */
            display: block;
            /* Ensure the div is a block element */
            text-align: center;
            /* This will center the text inside the div */
            position: relative;
        }

        .character {
            position: absolute;
            width: 200px;
            height: 200px;
            background-size: contain;
            background-repeat: no-repeat;
        }
    </style>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const designElement = document.querySelector('.design');

            // Set random character image
            const characterImages = [
                'https://cdn-icons-png.flaticon.com/256/15381/15381133.png',
                'https://cdn-icons-png.flaticon.com/256/15381/15381134.png',
                'https://cdn-icons-png.flaticon.com/256/15381/15381135.png',
                'https://cdn-icons-png.flaticon.com/256/15381/15381136.png',
                'https://cdn-icons-png.flaticon.com/256/15381/15381137.png',
                'https://cdn-icons-png.flaticon.com/256/15381/15381138.png',
                'https://cdn-icons-png.flaticon.com/256/15381/15381140.png',
                'https://cdn-icons-png.flaticon.com/256/8485/8485725.png',
                'https://cdn-icons-png.flaticon.com/256/9877/9877342.png',
                'https://cdn-icons-png.flaticon.com/256/9877/9877434.png',
                'https://cdn-icons-png.flaticon.com/256/9877/9877422.png',
                'https://cdn-icons-png.flaticon.com/256/9877/9877428.png',
                'https://cdn-icons-png.flaticon.com/256/9791/9791162.png'
            ];

            // Track positions of existing characters
            const existingPositions = new Set();

            // Function to create a floating character
            function createCharacter() {
                const character = document.createElement('div');
                character.classList.add('character');

                const randomImage = characterImages[Math.floor(Math.random() * characterImages.length)];
                character.style.backgroundImage = `url(${randomImage})`;

                // Calculate maximum left and top positions to keep character within bounds
                const maxWidth = designElement.offsetWidth - 200;
                const maxHeight = designElement.offsetHeight - 200;

                // Generate random position within bounds
                let left, top;
                do {
                    left = Math.random() * maxWidth;
                    top = Math.random() * maxHeight;
                } while (positionOverlaps(`${left}-${top}`));

                // Record this position to prevent overlapping
                existingPositions.add(`${left}-${top}`);

                // Set initial position
                character.style.left = `${left}px`;
                character.style.top = `${top}px`;

                // Append the character to the design element
                designElement.appendChild(character);

                // Remove character after a delay
                setTimeout(() => {
                    character.remove();
                    existingPositions.delete(`${left}-${top}`);
                }, 5000); // 20 seconds delay before removing
            }
            // Function to check if a new position overlaps with existing positions
            function positionOverlaps(position) {
                const [newLeft, newTop] = position.split('-').map(parseFloat);

                for (const pos of existingPositions) {
                    const [left, top] = pos.split('-').map(parseFloat);
                    const distance = Math.sqrt((newLeft - left) ** 2 + (newTop - top) ** 2);
                    if (distance < 100) { // Adjust distance as needed
                        return true;
                    }
                }
                return false;
            }
            // Create characters at random intervals
            setInterval(createCharacter, 2500); // Adjust interval as needed

            document.querySelectorAll('.insurance-button').forEach(button => {
                button.addEventListener('click', function () {
                    const type = this.getAttribute('data-type');
                    setInsuranceTypeAndRedirect(type);
                });
            });
        });
        $(document).ready(function () {
            const buttons = $('button');

            // Function to update active class based on current URL
            function updateActiveButton() {
                const currentPath = window.location.pathname;

                buttons.removeClass('active');

                buttons.each(function () {
                    const button = $(this);
                    const buttonOnclick = button.attr('onclick');

                    if (buttonOnclick && buttonOnclick.includes(currentPath)) {
                        button.addClass('active');
                    }
                });
            }

            // Initial call to set active class on page load
            updateActiveButton();

            // Click event handler for buttons
            buttons.click(function (event) {
                const onclickAttr = $(this).attr('onclick');

                if (onclickAttr) {
                    event.preventDefault();

                    // Update active class
                    buttons.removeClass('active');
                    $(this).addClass('active');

                    // Navigate to the clicked button's URL
                    const href = onclickAttr.replace("window.location.href = '", '').replace("';", '');
                    setTimeout(function () {
                        window.location.href = href;
                    }, 300); // Optional delay for visual feedback, adjust as needed
                }
            });
        });
        function setInsuranceTypeAndRedirect(type) {
            fetch('/insur/set-insurance-type', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ insuranceType: type }),
            })
                .then(response => {
                    if (response.ok) {
                        // Determine the redirection URL based on the insurance type
                        let redirectUrl = (type === 'Car') ? '/Car' : '/Insurance';

                        // Redirect to the appropriate page
                        window.location.href = redirectUrl;
                    } else {
                        console.error('Failed to set insurance type in session');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                });
        }
    </script>
</body>

</html>