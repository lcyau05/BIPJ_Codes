html
<div id="moneyInContent" class="container-viewcategory" style="display: none;">
    <h3>Categorised <span style="color: #9dd461;">Income</span></h3>
    <div style="margin-bottom: 15px; font-size: 1.2rem; color: #333;">For <strong>{{selectedMonth}}</strong></div>
    <table id="moneyInTable" border="1">
        <thead>
            <tr>
                <th>Category</th>
                <th>Amount</th>
            </tr>
        </thead>
        <tbody>
            {{#each categorizedIncome}}
            <tr>
                <td>{{category}}</td>
                <td>{{amount}}</td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>

<div id="moneyOutContent" class="container-viewcategory">
    <h3>Categorised <span style="color: #f3a8af;">Expenses</span></h3>
    <div style="margin-bottom: 15px; font-size: 1.2rem; color: #333;">For <strong>{{selectedMonth}}</strong></div>
    <table id="transactionsTableCategory" border="1">
        <thead>
            <tr>
                <th>Category</th>
                <th>Amount</th>
            </tr>
        </thead>
        <tbody>
            {{#each categorizedExpenses}}
            <tr>
                <td>{{category}}</td>
                <td>{{amount}}</td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>

<div class="container-viewlatest">
    {{#if latestExpenses}}
    <h3>Latest 5 Transactions</h3>
    <table id="latestTransactionsTable" border="1">
        <thead>
            <tr>
                <th>Transaction Type</th>
                <th>Category</th>
                <th>Amount</th>
                <th>Transaction Date</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            {{#each latestExpenses}}
            <tr>
                <td class="{{transactionType}}">{{transactionType}}</td>
                <td>{{category}}</td>
                <td>{{amount}}</td>
                <td>{{formatDate transactionDate 'DD-MM-YYYY'}}</td>
                <td>{{description}}</td>
            </tr>
            {{/each}}
        </tbody>
    </table>
    {{else}}
    <h5 class="no-transactions">No Transactions Made</h5>
    {{/if}}
    <button type="button" class="view-all-button" onclick="window.location.href='/viewalltransactions'">
        View All Transcations</button>
</div>

<br>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.4/Chart.js"></script>
<script>
    document.getElementById('moneyInButton').addEventListener('click', function() {
        document.getElementById('moneyInContent').style.display = 'block';
        document.getElementById('moneyOutContent').style.display = 'none';
    });

    document.getElementById('moneyOutButton').addEventListener('click', function() {
        document.getElementById('moneyInContent').style.display = 'none';
        document.getElementById('moneyOutContent').style.display = 'block';
    });

    // addEventListener listers for the change event which occue when a user selects a different option dropdown menu
    document.getElementById('monthDropdown').addEventListener('change', function () {
        // this.value gets selected menu and store it in selectedMonth
        const selectedMonth = this.value;
        // URL has month selected included 
        window.location.href = `/expensesdashboard?month=${encodeURIComponent(selectedMonth)}`;
    });

    const monthlyData = {{{ monthlyData }}};
    const labels = Object.keys(monthlyData);

    // Map each month label to its corresponding moneyIn value from monthlyData, creating an array of income data for each month
    const moneyInData = labels.map(month => monthlyData[month].moneyIn);
    // Map each month label to its corresponding moneyOut value from monthlyData, creating an array of expense data for each month
    const moneyOutData = labels.map(month => monthlyData[month].moneyOut);

    const ctx = document.getElementById('myChart').getContext('2d');
    const myChart = new Chart(ctx, {
        type: 'bar',
        data: {
            // x-axis (months)
            labels: labels,
            // 2 datasets (money in and money out)
            datasets: [{
                label: 'Money In',
                backgroundColor: '#dcedc8',
                borderColor: 'rgba(75, 192, 192, 1)',
                borderWidth: 1,
                data: moneyInData,
            }, {
                label: 'Money Out',
                backgroundColor: '#ffcdd2',
                borderColor: 'rgba(255, 99, 132, 1)',
                borderWidth: 1,
                data: moneyOutData,
            }]
        },
        options: {
            // Displays legend
            legend: { display: true },
            // Displays chart title 
            title: {
                display: true,
            }
        }
    });

    function updateChart(newMonthlyData) {
        // newMonthlyData retrieves the keys (month names) from the newMonthlyData object and assign to new labels
        const newLabels = Object.keys(newMonthlyData);
        const newMoneyInData = newLabels.map(month => newMonthlyData[month].moneyIn || 0);
        const newMoneyOutData = newLabels.map(month => newMonthlyData[month].moneyOut || 0);

        // Updates the labels on the x-axis
        myChart.data.labels = newLabels;
        // Updates the data for money in dataset
        myChart.data.datasets[0].data = newMoneyInData;
        // Updates the data for money out dataset
        myChart.data.datasets[1].data = newMoneyOutData;
        myChart.update();
    }

    // Finds the HTML element with the ID and sets its innerHTML to display the money in and money out value formated as "SGD[amount]"
    function updateMoneyInOut(moneyIn, moneyOut) {
        document.getElementById('moneyInButton').innerHTML = `<span class="main-text-money">Money In</span><span class="sub-text-money">SGD ${moneyIn}</span>`;
        document.getElementById('moneyOutButton').innerHTML = `<span class="main-text-money">Money Out</span><span class="sub-text-money">SGD ${moneyOut}</span>`;
    }

    // Finds the HTML element with the ID and sets the text content to display net cashflow formatted as "SGD[amount]"
    function updateNetCashflow(netCashflow) {
        document.getElementById('netCashflowAmount').textContent = `SGD ${netCashflow}`;
    }

    function AddBudget() {
        window.location.href = '/budgetform';
    }
</script>