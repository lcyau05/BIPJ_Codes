<style>
    body {
        font-family: 'Nunito', sans-serif;
    }

    .rounded-buttons {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 30px;
    }

    .rounded-btn {
        border-radius: 25px;
        padding: 12px 25px;
        font-size: 16px;
        cursor: pointer;
        border: none;
        color: #fff;
        transition: background-color 0.3s ease, transform 0.3s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    }

    .rounded-btn:hover {
        background-color: #555;
        transform: translateY(-3px);
    }

    .rounded-btn:active {
        background-color: #333;
        transform: translateY(1px);
    }

    .add-expenses-btn {
        background-color: #007bff;
    }

    .add-expenses-btn:hover {
        background-color: #0056b3;
    }

    .net-cashflow {
        text-align: center;
        margin-top: 20px;
        font-size: 18px;
    }

    .amount {
        text-align: center;
        font-size: 20px;
        color: red;
        margin-top: 5px;
    }

    .container-viewlatest,
    .container-viewcategory {
        margin: 20px auto;
        padding: 20px;
        border-radius: 8px;
        background-color: #ffffff;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        max-width: 1000px;
        overflow: hidden;
    }

    .container h3 {
        font-size: 1.5rem;
        color: #333333;
        margin-bottom: 15px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
        table-layout: fixed;
        font-size: 14px;
    }

    table th,
    table td {
        padding: 15px;
        text-align: left;
        border: 1px solid #dddddd;
        white-space: normal;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    table th {
        background-color: #f0f0f0;
        color: #555555;
        font-weight: bold;
        text-transform: uppercase;
        font-size: 13px;
    }

    table tbody tr:nth-child(even) {
        background-color: #f9f9f9;
    }

    table tbody tr:hover {
        background-color: #e6f7ff;
        transition: background-color 0.3s ease;
    }

    table tbody td.income {
        background-color: #dcedc8;
        color: #006400;
    }

    table tbody td.expense {
        background-color: #ffcdd2;
        color: #8b0000;
    }

    .container h5.no-transactions {
        font-size: 1.2rem;
        color: #888888;
        margin-top: 20px;
    }

    @media (max-width: 768px) {
        .container {
            padding: 15px;
        }

        table th,
        table td {
            padding: 12px;
        }
    }

    .rounded-buttons-money {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 20px;
    }

    .rounded-display-money-in,
    .rounded-display-money-out {
        border-radius: 30px;
        padding: 15px 30px;
        font-size: 18px;
        color: white;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        transition: background-color 0.3s ease;
        border: 2px solid;
    }

    .rounded-display-money-in {
        background-color: #dcedc8;
        border-color: #a8b98c;
    }

    .rounded-display-money-out {
        background-color: #ffcdd2;
        border-color: #e19ca4;
    }

    .main-text-money {
        font-size: 16px;
    }

    .sub-text-money {
        font-size: 12px;
        margin-top: 5px;
        color: #333;
    }

    .view-all-button {
        display: inline-block;
        padding: 10px 20px;
        font-size: 1em;
        color: #fff;
        background-color: #5f5f5f;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        text-align: center;
        margin-top: 20px;
        transition: background-color 0.3s ease;
    }

    .view-all-button:hover {
        background-color: #2b2929;
    }

    .image-button {
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        display: inline-block;
        outline: none;
        border-radius: 5px;
        overflow: hidden;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        margin-left: 1250px;
        margin-top: 20px;
    }

    .image-button img {
        display: block;
        max-width: 40px;
        height: auto;
        border-radius: 5px;
        transition: transform 0.3s ease, opacity 0.3s ease;
    }

    .image-button:hover img {
        opacity: 0.8;
        transform: scale(1.05);
    }

    .image-button:active img {
        transform: scale(0.95);
    }

    .dropdown-container {
        text-align: center;
    }

    .sidebar {
        width: 250px;
        background-color: #ffffff;
        padding: 20px;
        color: #333;
        height: 100vh;
        position: fixed;
        box-shadow: 2px 0 5px rgba(0, 0, 0, 0.1);
    }

    .sidebar h2 {
        color: #ebca5f;
        text-align: left;
        margin-bottom: 20px;
        font-size: 20px;
    }

    .sidebar ul {
        list-style: none;
        padding: 0;
    }

    .sidebar ul li {
        margin-bottom: 20px;
    }

    .sidebar ul li a {
        color: #333;
        text-decoration: none;
        font-size: 18px;
        display: block;
        padding: 10px;
        border-radius: 5px;
        transition: background-color 0.3s ease;
    }

    .sidebar ul li a:hover {
        background-color: #ebca5f;
        color: #fff;
    }
</style>

