<style>
        body {
            font-family: 'Nunito', sans-serif;
        }

        .container-goals,
        .container-view-update {
            margin: 20px auto;
            padding: 20px;
            border-radius: 8px;
            background-color: #ffffff;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            max-width: 1600px;
            overflow: hidden;
        }

        .container h3 {
            font-size: 1.5rem;
            color: #333333;
            margin-bottom: 15px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            table-layout: fixed;
            font-size: 14px;
        }

        table th,
        table td {
            padding: 15px;
            text-align: left;
            border: 1px solid #dddddd;
            white-space: normal;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        table th {
            background-color: #f0f0f0;
            color: #555555;
            font-weight: bold;
            text-transform: uppercase;
            font-size: 13px;
        }

        table tbody tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        table tbody tr:hover {
            background-color: #e6f7ff;
            transition: background-color 0.3s ease;
        }

        table tbody td.High {
            background-color: #ffcccb; /* Light Red */
            color: #a10000; /* Dark Red */
        }

        table tbody td.Medium {
            background-color: #ffeb99; /* Light Orange */
            color: #ff8c00; /* Dark Orange */
        }

        table tbody td.Low {
            background-color: #dcedc8; /* Light Green */
            color: #006400; /* Dark Green */
        }


        .container h5.no-transactions {
            font-size: 1.2rem;
            color: #888888;
            margin-top: 20px;
        }

        @media (max-width: 768px) {
            .container {
                padding: 15px;
            }
            table th,
            table td {
                padding: 12px;
            }
            .form-container {
                width: 90%;
            }
        }

        .action-btn {
            padding: 8px 15px;
            font-size: 12px;
            cursor: pointer;
            border: none;
            border-radius: 5px;
            transition: background-color 0.3s ease, transform 0.3s ease;
            color: white;
            width: 80px;
            text-align: center;
            margin-right: 5px;
        }

        .update-btn {
            background-color: #ebca5f;
        }

        .update-btn:hover {
            background-color: #bea243;
            transform: scale(1.05);
        }

        .delete-btn {
            background-color: #ff4d4d;
        }

        .delete-btn:hover {
            background-color: #cc0000;
            transform: scale(1.05);
        }

        .button-group {
            display: flex;
            justify-content: flex-start;
        }

        .form-container {
            width: 80%;
            max-width: 600px;
            margin: 20px auto;
            background-color: #f0f0f0;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        .form-field {
            margin-bottom: 15px;
        }

        .form-label {
            display: block;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .form-input {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
            box-sizing: border-box;
            font-size: 14px;
        }

        .form-select {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
            box-sizing: border-box;
            font-size: 14px;
        }

        #transaction-count {
            font-size: 1.2rem;
            color: #333333;
            margin-bottom: 15px;
        }

        .image-button {
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        display: inline-block;
        outline: none;
        border-radius: 5px;
        overflow: hidden;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        margin-left: 1450px;
        margin-top: 20px;
    }

    .image-button img {
        display: block;
        max-width: 40px;
        height: auto;
        border-radius: 5px;
        transition: transform 0.3s ease, opacity 0.3s ease;
    }

    .image-button:hover img {
        opacity: 0.8;
        transform: scale(1.05);
    }

    .image-button:active img {
        transform: scale(0.95);
    }
     .delete-btn {
        background-color: #ff4d4d;
    }

    .delete-btn:hover {
        background-color: #cc0000;
        transform: scale(1.05);
    }

    .filters {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin-bottom: 20px;
    }

    .filter-label {
        margin-right: 5px;
        font-size: 14px;
        vertical-align: middle; /* Adjust this value to lower the label */
        position: relative;
        top: 5px; /* Increase this value to lower the label further */

    }

    .filter-select,
    .filter-input {
        padding: 5px;
        border-radius: 5px;
        border: 1px solid #ccc;
    }

    .chart-container {
    margin-top: 20px;
    text-align: center;
}

#goalsChart {
    max-width: 600px;
    margin: 0 auto;
}

    </style>

<div class="container-xxl py-5">
        <div class="container">
            <div class="text-center wow fadeInUp" data-wow-delay="0.1s">
                <h1 class="mb-5">MANAGE YOUR OWN GOALS</h1>
                <h6 class="section-title bg-white text-center text-primary px-3">- DASHBOARD -</h6>
            </div>
        </div>
    </div>

    <button type="button" class="image-button" onclick="window.location.href='/goalsform'">
    <img src="/img/plus.jpg" alt="Button Image" />
</button>

<div class="chart-container">
        <canvas id="goalsChart"></canvas>
        <br>
        <p id="totalAmount">Total Amount to Save: $0</p>
    </div>

<div class="container-goals">
    <h3>Completed Goals</h3>
    <table id="completedGoalsTable">
        <thead>
            <tr>
                <th>Category</th>
                <th>Name</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>

    <div class="container-goals">
        {{#if goals}}
        <h3>View All Goals</h3>

        <!-- Filter Section -->
        <div class="filters">
            <label class="filter-label" for="filterCategory">Category:</label>
            <select id="filterCategory" class="filter-select" onchange="applyFilters()">
                <option value="All">All</option>
                <option value="Travel">Travel</option>
                <option value="Investment">Investment</option>
                <option value="Debt Repayment">Debt Repayment</option>
                <option value="Emergency">Emergency Fund</option>
                <option value="Education">Education</option>
                <option value="Car">Car</option>
                <option value="Retirement">Retirement</option>
                <option value="Others">Others</option>
            </select>

            <label class="filter-label" for="filterMonth">Month:</label>
    <select id="filterMonth" class="filter-select" onchange="applyFilters()">
        <option value="All">All</option>
        <!-- Generate months dynamically or hard-code if preferred -->
        <option value="01">January</option>
        <option value="02">February</option>
        <option value="03">March</option>
        <option value="04">April</option>
        <option value="05">May</option>
        <option value="06">June</option>
        <option value="07">July</option>
        <option value="08">August</option>
        <option value="09">September</option>
        <option value="10">October</option>
        <option value="11">November</option>
        <option value="12">December</option>
    </select>

            <label class="filter-label" for="filterPriority">Priority:</label>
            <select id="filterPriority" class="filter-select" onchange="applyFilters()">
                <option value="All">All</option>
                <option value="High">High</option>
                <option value="Medium">Medium</option>
                <option value="Low">Low</option>
            </select>
        </div>


        <table id="goalsTable">
            <thead>
                <tr>
                    <th>Category</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Target Amount</th>
                    <th>Current Amount</th>
                    <th>Amount Remaining</th>
                    <th>Deadline</th>
                    <th>Priority</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {{#each goals}}
                    <tr>
                        <td>{{category}}</td>
                        <td>{{name}}</td>
                        <td>{{description}}</td>
                        <td>{{targetAmount}}</td>
                        <td>{{currentAmount}}</td>
                        <td>{{deadline}}</td>
                        <td>{{amountRemaining}}</td>
                        <td class="{{priority}}">{{priority}}</td>
                        <td>
                            <div class="button-group">
                                <button type="button" class="action-btn update-btn"
                                    onclick="showUpdateForm('{{id}}', '{{category}}', '{{name}}', '{{description}}', '{{targetAmount}}', '{{currentAmount}}', '{{deadline}}')">
                                    Update
                                </button>
                                <button type="button" class="action-btn delete-btn" onclick="deleteTransaction('{{id}}')">
                                    Delete
                                </button>
                            </div>
                        </td>
                    </tr>
                    {{/each}}

            </tbody>
        </table>

    {{else}}
        <h5 class="no-transactions">No Goals Made</h5>
    {{/if}}
    </div>

    <div class="container-view-update">
        <div id="update-form" style="display: none;">
            <h3>Update Goal</h3>
            <form action="/goals/updateGoals" method="POST">
                <input type="hidden" id="update-id" name="id">

                <label for="category">Category</label>
                <select id="category" name="category" class="form-select">
                    <option value="Travel">Travel</option>
                    <option value="Investment">Investment</option>
                    <option value="Debt Repayment">Debt Repayment</option>
                    <option value="Emergency">Emergency Fund</option>
                    <option value="Education">Education</option>
                    <option value="Car">Car</option>
                    <option value="Retirement">Retirement</option>
                    <option value="Others">Others</option>
                </select>
                
                <label for="name">Goal Name</label>
                <input type="text" id="name" name="name" class="form-input">
                
                <label for="description">Description</label>
                <textarea id="description" name="description" class="form-input" rows="3"></textarea>
                
                <label for="targetAmount">Target Amount</label>
                <input type="number" id="targetAmount" name="targetAmount" class="form-input" step="0.01">
                
                <label for="currentAmount">Current Amount</label>
                <input type="number" id="currentAmount" name="currentAmount" class="form-input" step="0.01">
                
                <label for="deadline">Deadline</label>
                <input type="date" id="deadline" name="deadline" class="form-input">
                <br>
                <br>
                <div class="button-group">
                    <button type="submit" class="action-btn update-btn">Update</button>
                </div>
            </form>
        </div>
    </div>

   <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    let goalsPieChart = null; // Global variable to hold the chart instance

document.addEventListener('DOMContentLoaded', function() {
    fetch('/api/goals')
        .then(response => response.json())
        .then(data => {
            console.log('Fetched Goals Data:', data);
            renderGoals(data); // Call renderGoals with the fetched data
        })
        .catch(error => console.error('Error:', error));
});

function getPriority(deadline) {
    const now = new Date();
    const deadlineDate = new Date(deadline);
    const timeDiff = deadlineDate - now;
    const daysToDeadline = Math.ceil(timeDiff / (1000 * 60 * 60 * 24)); // Convert to days

    if (daysToDeadline <= 30) {
        return 'High';
    } else if (daysToDeadline > 30 && daysToDeadline <= 180) {
        return 'Medium';
    } else {
        return 'Low';
    }
}

function renderGoals(goalsData) {
    const tableBody = document.querySelector('#goalsTable tbody');
    const completedTableBody = document.querySelector('#completedGoalsTable tbody');

    tableBody.innerHTML = ''; // Clear existing rows
    completedTableBody.innerHTML = ''; // Clear existing rows

    goalsData.forEach(goal => {
        const priority = getPriority(goal.deadline);
        const amountRemaining = goal.targetAmount - goal.currentAmount; // Calculate remaining amount

        if (amountRemaining === 0) {
            // Create a row for completed goals with only the relevant fields
            const completedRow = document.createElement('tr');
            completedRow.innerHTML = `
                <td>${goal.category}</td>
                <td>${goal.name}</td>
                <td>${goal.description}</td>
            `;
            completedTableBody.appendChild(completedRow);
        } else {
            // Create a row for active goals with all fields
            const activeRow = document.createElement('tr');
            activeRow.innerHTML = `
                <td>${goal.category}</td>
                <td>${goal.name}</td>
                <td>${goal.description}</td>
                <td>${goal.targetAmount}</td>
                <td>${goal.currentAmount}</td>
                <td>${amountRemaining}</td>
                <td>${goal.deadline}</td>
                <td class="${priority}">${priority}</td>
                <td>
                    <div class="button-group">
                        <button type="button" class="action-btn update-btn"
                            onclick="showUpdateForm('${goal.id}', '${goal.category}', '${goal.name}', '${goal.description}', '${goal.targetAmount}', '${goal.currentAmount}', '${goal.deadline}')">
                            Update
                        </button>
                        <button type="button" class="action-btn delete-btn" onclick="deleteTransaction('${goal.id}')">
                            Delete
                        </button>
                    </div>
                </td>
            `;
            tableBody.appendChild(activeRow);
        }
    });

    // Update the chart with the latest data
    updateChart(goalsData);
}

function updateChart(goalsData) {
    const ctx = document.getElementById('goalsChart').getContext('2d');
    const categories = {};
    let totalAmountRemaining = 0;

    // Calculate total amount remaining and category distribution
    goalsData.forEach(goal => {
        const amountRemaining = goal.targetAmount - goal.currentAmount;
        if (!categories[goal.category]) {
            categories[goal.category] = 0;
        }
        categories[goal.category] += amountRemaining;
        totalAmountRemaining += amountRemaining;
    });

    // Prepare data for the pie chart
    const chartData = {
        labels: Object.keys(categories),
        datasets: [{
            data: Object.values(categories),
            backgroundColor: ['#ff9999', '#66b3ff', '#99ff99', '#ffcc99'], // Add more colors if needed
            borderColor: '#ffffff',
            borderWidth: 1
        }]
    };

    // Destroy the previous chart instance if it exists
    if (goalsPieChart) {
        goalsPieChart.destroy();
    }

    // Create the pie chart
    goalsPieChart = new Chart(ctx, {
        type: 'pie',
        data: chartData,
        options: {
            responsive: true,
            plugins: {
                legend: {
                    position: 'top',
                },
                tooltip: {
                    callbacks: {
                        label: function(tooltipItem) {
                            return tooltipItem.label + ': $' + tooltipItem.raw;
                        }
                    }
                }
            }
        }
    });

    // Update total amount display
    document.getElementById('totalAmount').textContent = `Total Amount Remaining: $${totalAmountRemaining}`;
}


function showUpdateForm(id, category, name, description, targetAmount, currentAmount, deadline) {
    document.getElementById('update-form').style.display = 'block';
    document.getElementById('update-id').value = id;
    document.getElementById('category').value = category;
    document.getElementById('name').value = name;
    document.getElementById('description').value = description;
    document.getElementById('targetAmount').value = targetAmount;
    document.getElementById('currentAmount').value = currentAmount;
    document.getElementById('deadline').value = deadline;
}

function applyFilters() {
    const categoryFilter = document.getElementById('filterCategory').value;
    const monthFilter = document.getElementById('filterMonth').value;
    const priorityFilter = document.getElementById('filterPriority').value;

    const rows = document.querySelectorAll('#goalsTable tbody tr');

    rows.forEach(row => {
        const category = row.querySelector('td:nth-child(1)').textContent;
        const deadline = row.querySelector('td:nth-child(7)').textContent;
        const priority = row.querySelector('td:nth-child(8)').textContent;

        // Extract month from the deadline
        const deadlineDate = new Date(deadline);
        const deadlineMonth = deadlineDate.getMonth() + 1; // Months are zero-based, so add 1

        let showRow = true;

        // Filter by category
        if (categoryFilter !== 'All' && category !== categoryFilter) {
            showRow = false;
        }

        // Filter by month
        if (monthFilter !== 'All' && monthFilter !== '' && deadlineMonth !== parseInt(monthFilter)) {
            showRow = false;
        }

        // Filter by priority
        if (priorityFilter !== 'All' && priority !== priorityFilter) {
            showRow = false;
        }

        row.style.display = showRow ? '' : 'none';
    });
}

function deleteTransaction(id) {
    if (confirm("Are you sure you want to delete this goal?")) {
        fetch(`/deleteGoal/${id}`, {
            method: 'DELETE',
        })
            .then(response => {
                if (response.ok) {
                    location.reload();
                    alert("Goal deleted successfully");
                } else {
                    alert("Failed to delete the goal");
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert("An error occurred while deleting the goal");
            });
    }
}
</script>