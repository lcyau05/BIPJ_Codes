<div class="container d-flex justify-content-center mt-50 mb-50">
    <div class="row">
        <div class="col-md-12 text-right mb-3">
            <button class="btn btn-primary" id="download"><i class="fas fa-download"></i> PDF</button>
        </div>
        <div class="col-md-12">
            <div class="card" id="invoice">
                <div class="card-header bg-transparent header-elements-inline">
                    <h2 class="card-title text-primary"><img src="/img/genwise_bipj.png" alt="journeyjunction logo"
                            style="width: 80px; height: 80px;">&nbsp;GenWise</h2>
                    <p class="card-title">180 Ang Mo Kio Ave 8, Singapore 569830 <br>+65 6451 5115</p>
                </div><br>
                <h4 style="padding-left: 30px;">Customer Details</h4>
                <table width="100%" style="border-collapse: collapse; ">
                    <tr>
                        <td widdth="50%" style="background:#eee;">
                            <strong>Date:</strong> {{ formatDate insurancePlanCreation.createdAt 'DD MMM YYYY'}}<br>
                            <strong>Payment type:</strong> Credit Card {{insurancePlanCreation.cardType}}<br>
                            <strong>Delivery type:</strong> via Email<br>
                        </td>
                        <td style="background:#eee;padding:20px;">
                            <strong>Invoice ID:</strong> #{{carDetails.insurancebought}}<br>
                            <strong>E-mail:</strong> {{userDetails.email}}<br>
                            <strong>Phone:</strong>&nbsp;{{userDetails.phone_no}}<br>
                        </td>
                    </tr>
                </table><br>
                <div style="margin: 0 auto;">
                    <table class="insuranceplan">
                        <thead>
                            <tr style="background-color: #FD8087;">
                                <th>Features</th> <!-- This will be the row headers -->
                                <th>{{insurancePlanCreation.planName}}</th> <!-- Each planName as column header -->
                            </tr>
                        </thead>
                        <tbody>
                            {{#each insurancePlan}}
                            <tr>
                                <td>{{ this.featName }}</td> <!-- Each featName as row header -->
                                <td>
                                    {{#ifEquals this.planName ../insurancePlanCreation.planName }}
                                    {{ this.featCost }}
                                    {{else}}
                                    N/A
                                    {{/ifEquals}}
                                </td> <!-- featCost under corresponding planName -->
                            </tr>
                            {{/each}}
                            <tr>
                                <td>
                                    <h5 class="font-weight-semibold">Total</h5>
                                </td>
                                <td>
                                    <h5 class="font-weight-semibold">${{insurancePlanCreation.totalCost}}</h5>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="card-footer" style="text-align: center;">
                    <h3>Terms and Conditions</h3>
                    <p>1. All insurance plans are non-refundable once purchased.</p>
                    <p>2. Please ensure all provided information is accurate. Incorrect details may void your insurance
                        coverage.</p>
                    <p>3. The insurance coverage is subject to the terms and conditions outlined in the policy document.
                    </p>
                    <p>4. Claims must be reported within the timeframe specified in your insurance policy.</p>
                    <p>5. The insurer reserves the right to amend the terms and conditions of the policy at any time.
                    </p>
                    <p>6. The policyholder is responsible for understanding and complying with all policy terms and
                        conditions.</p>
                    <p>7. This insurance is only valid for the coverage period stated in the policy document.</p>
                    <p>8. Any disputes arising from the insurance policy will be resolved in accordance with the laws of
                        Singapore.</p>
                    <p>9. By purchasing this insurance, you agree to abide by all the terms and conditions stated
                        herein.</p>
                    <p>&copy; 2024 GenWise Insurance. All Rights Reserved.</p>
                </div>
            </div>
        </div>
    </div>
</div>
<style>
    body {
        margin: 0 auto;
        font-family: Roboto, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
        font-size: .8125rem;
        font-weight: 400;
        line-height: 1.5385;
        color: #333;
        text-align: left;
        background-color: #eee
    }

    .insuranceplan {
        width: 7in;
        /*height: 1617px;*/
        height: auto;
        margin: 0 auto;
        border-radius: 20px;
        border: 2px solid #000;
        background: #FFF;
    }

    .insuranceplan th,
    td {
        text-align: center;
        padding: 15px;
    }

    .mt-50 {
        margin-top: 50px
    }

    .mb-50 {
        margin-bottom: 50px
    }

    .card {
        word-wrap: break-word;
        background-color: #fff;
        background-clip: border-box;
        border: 1px solid rgba(0, 0, 0, .125);
        border-radius: .1875rem;
        width: 100%;
        max-width: 8.27in;
        /* A4 page width */
        margin: 0 auto;
        /* Center the card */
    }

    .card-img-actions {
        position: relative
    }

    .card-body {
        margin: 0 auto;
        -ms-flex: 1 1 auto;
        flex: 1 1 auto;
        padding: 1.25rem;
        text-align: center
    }

    .card-title {
        margin-top: 10px;
        text-align: center;
        margin: 0 auto;
    }

    .card-header {
        padding: .9375rem 1.25rem;
        margin-bottom: 0;
        background-color: rgba(0, 0, 0, .02);
        border-bottom: 1px solid rgba(0, 0, 0, .125)
    }

    a {
        text-decoration: none !important
    }

    .btn-light {
        color: #333;
        background-color: #fafafa;
        border-color: #ddd
    }

    .header-elements-inline {
        display: -ms-flexbox;
        display: flex;
        -ms-flex-align: center;
        align-items: center;
        -ms-flex-pack: justify;
        justify-content: space-between;
        -ms-flex-wrap: nowrap;
        flex-wrap: nowrap
    }

    @media (min-width: 768px) {
        .wmin-md-400 {
            min-width: 400px !important
        }
    }

    .btn-primary {
        color: #fff;
        background-color: #FAD676
    }
</style>
<script>
    window.onload = function () {
        document.getElementById("download").addEventListener("click", () => {
            const invoice = this.document.getElementById("invoice");
            console.log(invoice);
            console.log(window);
            var opt = {
                margin: 0.5,
                filename: 'invoice.pdf',
                image: { type: 'jpeg', quality: 1 },
                html2canvas: { scale: 2 },
                jsPDF: { unit: 'in', format: 'a4', orientation: 'portrait' }
            };
            html2pdf().from(invoice).set(opt).save();
        })
    }
</script>