<div class="container-xxl py-5">
    <div class="container">
        <div class="text-center wow fadeInUp" data-wow-delay="0.1s">
            <h6 class="section-title bg-white text-center text-primary px-3">- EDIT INSURANCE -</h6>
            <h1 class="mb-5">VIEW INSURANCE PLAN</h1>
        </div>
    </div>
</div>
<div class="container">
    <form id="insuranceForm" action="">
        {{#each features}}
        <label for="typeOfInsurance">Type of Insurance</label>
        <select id="typeOfInsurance" name="typeOfInsurance" required>
            <option value="{{planCategory}}">{{planCategory}}</option>
            <option value="Car">Car</option>
            <option value="Home">Home</option>
            <option value="Life">Life</option>
            <option value="Medical">Medical</option>
            <option value="Travel">Travel</option>
        </select>
        <br><br>
        <div class="form-floating">
            <input type="text" class="form-control" id="name" placeholder="Name" value="{{planName}}">
            <label for="name">Insurance Plan Name</label>
        </div>
        <div class="feature-group">
            <h5>Feature 1</h5>
            <div class="row g-3 feature-item">
                <div class="row g-3">
                    <div class="col-lg-12 col-xl-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="featureName1" placeholder="Feature Name" value="{{featName}}">
                            <label for="featureName1">Feature Name</label>
                        </div>
                    </div>
                    <div class="col-lg-12 col-xl-6">
                        <div class="form-floating">
                            <input type="number" class="form-control" id="cost1" placeholder="Feature Cost" min="0" value="{{featCost}}">
                            <label for="cost1">Feature Cost ($)</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-floating">
                            <textarea class="form-control" placeholder="Feature Description" id="description1"
                                style="height: 120px">{{featDescription}}</textarea>
                            <label for="description1">Description</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {{/each}}
        <br><br>
        <div class="col-12">
            <button class="btn btn-primary w-100 py-3" type="submit">Create</button>
        </div>
    </form>
</div>
<style>
    .feature-group {
        padding: 20px 0;
    }

    .optional-group {
        padding: 20px 0;
    }

    h5 {
        margin-top: 20px;
        /* Add margin-top to headings for separation */
    }
</style>